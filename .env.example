# Copy to .env and fill only what you want to enable. Everything
# works offline with all of these empty.

# Stripe test mode secret key (starts with sk_test_). Enables real
# PSP calls in the ledger service.
STRIPE_API_KEY=

# Anthropic API key. Enables the LLM investigator agent. Without it
# the deterministic rule based advisor runs instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Slack incoming webhook URL for review notifications.
SLACK_WEBHOOK_URL=

# Resend API key and addresses for review emails.
RESEND_API_KEY=
RESEND_FROM=fraud@example.com
RESEND_TO=analyst@example.com

# Set to ipapi to resolve real IPs through ipapi.co in fraud and
# investigator services. Default static resolver needs no network.
GEO_PROVIDER=static
