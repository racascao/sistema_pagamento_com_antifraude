{
 "title": "Payment Processor",
 "uid": "payment-processor",
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Authorization latency (gateway)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.99, sum(rate(gateway_http_request_duration_seconds_bucket{route=\"/v1/payments\"}[1m])) by (le))",
     "legendFormat": "p99",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.50, sum(rate(gateway_http_request_duration_seconds_bucket{route=\"/v1/payments\"}[1m])) by (le))",
     "legendFormat": "p50",
     "refId": "B"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Requests per second by status code",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(gateway_http_request_duration_seconds_count[1m])) by (code)",
     "legendFormat": "{{code}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Decisions per second by status",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "approved"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "denied"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "manual_review"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "yellow"
        }
       }
      ]
     }
    ]
   },
   "targets": [
    {
     "expr": "sum(rate(ledger_decisions_total[1m])) by (status)",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Fraud pipeline stage p99",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.99, sum(rate(fraud_stage_duration_seconds_bucket[1m])) by (le, stage))",
     "legendFormat": "{{stage}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Approved (15m)",
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 0,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(increase(ledger_decisions_total{status=\"approved\"}[15m]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Denied (15m)",
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 4,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "fixed",
      "fixedColor": "red"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(increase(ledger_decisions_total{status=\"denied\"}[15m]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 7,
   "type": "stat",
   "title": "Manual review (15m)",
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 8,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "fixed",
      "fixedColor": "yellow"
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(increase(ledger_decisions_total{status=\"manual_review\"}[15m]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 8,
   "type": "stat",
   "title": "Outbox waiting",
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 12,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 50
       },
       {
        "color": "red",
        "value": 500
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "ledger_outbox_unpublished",
     "refId": "A"
    }
   ]
  },
  {
   "id": 9,
   "type": "stat",
   "title": "SSE clients",
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 16,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(gateway_sse_clients)",
     "refId": "A"
    }
   ]
  },
  {
   "id": 10,
   "type": "stat",
   "title": "Degraded verdicts (15m)",
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 20,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(increase(fraud_verdicts_total{degraded=\"true\"}[15m])) or vector(0)",
     "refId": "A"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Investigations by recommendation",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 21
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(investigator_recommendations_total[5m])) by (recommendation)",
     "legendFormat": "{{recommendation}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Investigation duration p95 by advisor",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 21
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum(rate(investigator_investigation_duration_seconds_bucket[5m])) by (le, advisor))",
     "legendFormat": "{{advisor}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 13,
   "type": "stat",
   "title": "Approval rate (15m)",
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 0,
    "y": 29
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(increase(ledger_decisions_total{status=\"approved\",replayed=\"false\"}[15m])) / sum(increase(ledger_decisions_total{replayed=\"false\"}[15m]))",
     "legendFormat": "approval",
     "refId": "A"
    }
   ]
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Money volume per minute by decision",
   "gridPos": {
    "h": 6,
    "w": 9,
    "x": 6,
    "y": 29
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyBRL"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(ledger_amount_cents_total[5m])) by (status) * 60 / 100",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "Review queue by status",
   "gridPos": {
    "h": 6,
    "w": 9,
    "x": 15,
    "y": 29
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "expr": "ledger_reviews",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 16,
   "type": "timeseries",
   "title": "Decision reasons per second",
   "gridPos": {
    "h": 6,
    "w": 9,
    "x": 0,
    "y": 35
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(fraud_reasons_total[5m])) by (reason)",
     "legendFormat": "{{reason}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 17,
   "type": "timeseries",
   "title": "Risk score distribution (p50/p90/p99)",
   "gridPos": {
    "h": 6,
    "w": 9,
    "x": 9,
    "y": 35
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "max": 1,
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.50, sum(rate(fraud_risk_score_bucket[10m])) by (le))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.90, sum(rate(fraud_risk_score_bucket[10m])) by (le))",
     "legendFormat": "p90",
     "refId": "B"
    },
    {
     "expr": "histogram_quantile(0.99, sum(rate(fraud_risk_score_bucket[10m])) by (le))",
     "legendFormat": "p99",
     "refId": "C"
    }
   ]
  },
  {
   "id": 18,
   "type": "stat",
   "title": "Idempotent replays (15m)",
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 18,
    "y": 35
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(increase(ledger_decisions_total{replayed=\"true\"}[15m]))",
     "legendFormat": "replays",
     "refId": "A"
    }
   ]
  },
  {
   "id": 19,
   "type": "stat",
   "title": "Human agreement with agent (15m)",
   "gridPos": {
    "h": 6,
    "w": 6,
    "x": 0,
    "y": 41
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(increase(ledger_review_decisions_total{followed_recommendation=\"true\"}[15m])) / sum(increase(ledger_review_decisions_total[15m]))",
     "legendFormat": "agreement",
     "refId": "A"
    }
   ]
  },
  {
   "id": 20,
   "type": "timeseries",
   "title": "Human review decisions",
   "gridPos": {
    "h": 6,
    "w": 9,
    "x": 6,
    "y": 41
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(increase(ledger_review_decisions_total[15m])) by (decision, followed_recommendation)",
     "legendFormat": "{{decision}} followed={{followed_recommendation}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 21,
   "type": "timeseries",
   "title": "End-to-end authorize latency (ledger)",
   "gridPos": {
    "h": 6,
    "w": 9,
    "x": 15,
    "y": 41
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.50, sum(rate(ledger_authorize_duration_seconds_bucket[1m])) by (le))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.95, sum(rate(ledger_authorize_duration_seconds_bucket[1m])) by (le))",
     "legendFormat": "p95",
     "refId": "B"
    },
    {
     "expr": "histogram_quantile(0.99, sum(rate(ledger_authorize_duration_seconds_bucket[1m])) by (le))",
     "legendFormat": "p99",
     "refId": "C"
    }
   ]
  }
 ]
}